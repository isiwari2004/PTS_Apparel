@model List<PTS_Apparel.Models.Customer>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Customer Management - ApparelPTS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            body {
                display: flex;
                background: #f4f6f9;
                margin: 0;
                font-family: 'Segoe UI';
            }

            .sidebar {
                width: 250px;
                background-color: #1e3250;
                color: white;
                min-height: 100vh;
                padding: 20px;
                flex-shrink: 0;
            }

                .sidebar a {
                    color: #a4b6d4;
                    text-decoration: none;
                    display: block;
                    padding: 10px;
                    border-radius: 5px;
                    margin-bottom: 5px;
                    transition: 0.3s;
                }

                    .sidebar a:hover, .sidebar a.active {
                        background: rgba(255,255,255,0.1);
                        color: white;
                    }

            .green-icon {
                color: #2ecc71;
            }

            .sidebar hr {
                border-color: rgba(255,255,255,0.1);
            }

            .content {
                flex: 1;
                padding: 30px;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 25px;
            }

            .page-title h4 {
                font-weight: 700;
                color: #222;
                margin: 0;
            }

            .page-title p {
                color: #777;
                font-size: 14px;
                margin: 5px 0 0 0;
            }

            .search-bar {
                background: white;
                padding: 15px;
                border-radius: 10px;
                border: 1px solid #eef2f6;
                display: flex;
                flex-wrap: wrap;
                gap: 15px;
                margin-bottom: 25px;
                align-items: center;
            }

            .search-input {
                background: #f8f9fa;
                border: 1px solid #eef2f6;
                border-radius: 8px;
                padding: 8px 15px;
                flex: 1;
                min-width: 200px;
                outline: none;
            }

                .search-input:focus {
                    border-color: #203455;
                }

            .btn-dark-custom {
                background-color: #203455;
                color: white;
                border: none;
                border-radius: 6px;
                padding: 8px 16px;
                transition: 0.3s;
            }

            .btn-outline-custom {
                border: 1px solid #ced4da;
                background: white;
                border-radius: 6px;
                padding: 7px 15px;
                color: #555;
                transition: 0.3s;
            }

            .add-btn {
                display: flex;
                align-items: center;
                gap: 5px;
                margin-left: auto;
                cursor: pointer;
            }

            .table-container {
                background: white;
                border-radius: 12px;
                border: 1px solid #eef2f6;
                overflow: hidden;
                box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 14px;
            }

                .custom-table thead {
                    background: #f8fafc;
                    border-bottom: 1px solid #eef2f6;
                }

                .custom-table th {
                    text-align: left;
                    padding: 15px 20px;
                    color: #778ca2;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 11px;
                    letter-spacing: 0.5px;
                }

                .custom-table td {
                    padding: 20px;
                    border-bottom: 1px solid #f1f4f8;
                    color: #333;
                }

                .custom-table tr:last-child td {
                    border-bottom: none;
                }

            .action-icons a {
                color: #778ca2;
                margin: 0 5px;
                transition: 0.2s;
                text-decoration: none;
                cursor: pointer;
            }

                .action-icons a:hover {
                    color: #203455;
                }

                .action-icons a.btn-delete:hover {
                    color: #dc3545;
                }

            .modal-header {
                background: #f8fafc;
                border-bottom: 1px solid #eef2f6;
            }

            .modal-footer {
                border-top: 1px solid #eef2f6;
            }

            /* Pagination CSS (Image එකට හරියන විදියට) */
            .pagination-container {
                display: flex;
                justify-content: flex-end;
                margin-top: 20px;
                padding-right: 15px;
            }
            .pagination-custom .page-item .page-link {
                color: #555;
                border: 1px solid #ddd;
                border-radius: 6px;
                margin: 0 3px;
                min-width: 38px;
                text-align: center;
            }
            .pagination-custom .page-item.active .page-link {
                background: linear-gradient(135deg, #b03ce6, #d63384); /* Image එකේ විදියට දම්/රෝස පාට */
                border-color: #b03ce6;
                color: white;
                box-shadow: 0 2px 5px rgba(179, 60, 230, 0.3);
            }
            .pagination-custom .page-item .page-link:hover {
                background: #f1f1f1;
                color: #333;
                border-color: #ccc;
            }
            .pagination-custom .page-item.active .page-link:hover {
                background: linear-gradient(135deg, #b03ce6, #d63384);
                color: white;
            }

            @@media (max-width: 768px) {
                .sidebar {
                    display: none;
                }

                .add-btn {
                    margin-left: 0;
                    width: 100%;
                }
            }
    </style>
</head>
<body>
    <div class="sidebar">
        <h5><i class="fas fa-cut green-icon"></i> ApparelPTS</h5>
        <hr>
        <a href="/Home/Dashboard"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/Factory/Index"><i class="fas fa-industry"></i> Factory</a>
        <a href="/Customer/Index" class="active"><i class="fas fa-user-friends"></i> Customer</a>
        <a href="/Style/Index"><i class="fas fa-tshirt"></i> Style</a>
        <a href="/POManagement/Index"><i class="fas fa-file-invoice"></i> PO</a>
        <<a href="/InputRecorder/Index"><i class="fas fa-clipboard-list"></i> Input Recorder</a>
        <a href="/Forecast/Index" class="active"><i class="fas fa-chart-line"></i> Forecast</a>
        <a href="#"><i class="fas fa-list-ul"></i> Line Recorder</a>
        <a href="#"><i class="fas fa-clock"></i> Hourly Tracking</a>
        <a href="#"><i class="fas fa-exclamation-triangle"></i> Defect Report</a>
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a href="/Home/ScreenPrivileges"><i class="fas fa-lock"></i> Screen Privileges</a>
            <a href="/User/Register"><i class="fas fa-user-plus"></i> User Register</a>
        }
        <hr>
        <a href="/Account/Logout" class="text-danger"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>

    <div class="content">
        <div class="page-header">
            <div class="page-title">
                <h4>Customer Management</h4>
                <p>Manage apparel manufacturing customers and buyer information.</p>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="search-bar">
            <div class="input-group" style="flex: 1; min-width: 200px;">
                <span class="input-group-text bg-light border-end-0" style="background:#f8f9fa; border-color:#eef2f6;"><i class="fas fa-search text-muted"></i></span>
                <!-- 👇 Search කරන විටත් page එක 1 ට reset වෙන්න onkeyup එක එකතු කරලා -->
                <input type="text" id="searchInput" class="form-control border-start-0 bg-light" style="background:#f8f9fa; border-color:#eef2f6;" placeholder="Search customers..." onkeyup="searchCustomers()">
            </div>
            <button class="btn-outline-custom" onclick="location.reload()"><i class="fas fa-sync-alt me-1"></i> Refresh</button>
            <button class="btn-dark-custom add-btn" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
                <i class="fas fa-plus"></i> Add Customer
            </button>
        </div>

        <!-- Data Table -->
        <div class="table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 45%;">CUSTOMER NAME</th>
                        <th style="width: 35%;">CUSTOMER TYPE</th>
                        <th style="width: 20%; text-align: right; padding-right: 30px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody id="customerTableBody">
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var cust in Model)
                        {
                            <tr id="row-@cust.Id">
                                <td><strong>@cust.CustomerName</strong></td>
                                <td>@cust.CustomerType</td>
                                <td style="text-align: right; padding-right: 30px;">
                                    <div class="action-icons">
                                        <a class="btn-edit" onclick="openEditModal(@cust.Id)"><i class="fas fa-pen"></i></a>
                                        <a class="btn-delete" onclick="deleteCustomer(@cust.Id)"><i class="fas fa-trash-alt"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noDataRow">
                            <td colspan="3" class="text-center py-4 text-muted">
                                <i class="fas fa-users me-2"></i> No customers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

       
        @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
        {
            <div class="pagination-container">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-custom">
                        @{
                            int currentPage = ViewBag.CurrentPage ?? 1;
                            int totalPages = ViewBag.TotalPages ?? 1;
                            string currentSearch = ViewBag.CurrentSearch ?? "";
                        }

                        <!-- Prev Button -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, searchTerm = currentSearch })" aria-label="Previous">
                                <span aria-hidden="true">&lt; Prev</span>
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, searchTerm = currentSearch })">@i</a>
                            </li>
                        }

                        <!-- Next Button -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, searchTerm = currentSearch })" aria-label="Next">
                                <span aria-hidden="true">Next &gt;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

    </div>

    <!-- ADD CUSTOMER MODAL -->
    <div class="modal fade" id="addCustomerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus-circle me-2 text-success"></i>Add New Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="addCustomerForm">
                        <div class="mb-3">
                            <label class="form-label">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="CustomerName" placeholder="Enter customer name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Customer Type <span class="text-danger">*</span></label>
                            <select class="form-control" name="CustomerType" required>
                                <option value="">Select Type</option>
                                <option value="Internal">Internal</option>
                                <option value="Buyer">Buyer</option>
                                <option value="External">External</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-dark-custom" onclick="saveCustomer('add')"><i class="fas fa-save me-2"></i> Save Customer</button>
                </div>
            </div>
        </div>
    </div>

    <!-- EDIT CUSTOMER MODAL -->
    <div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit me-2 text-primary"></i>Edit Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="editCustomerForm">
                        <input type="hidden" id="edit_Id" name="Id">
                        <div class="mb-3">
                            <label class="form-label">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="edit_CustomerName" name="CustomerName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Customer Type <span class="text-danger">*</span></label>
                            <select class="form-control" id="edit_CustomerType" name="CustomerType" required>
                                <option value="Internal">Internal</option>
                                <option value="Buyer">Buyer</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-dark-custom" onclick="saveCustomer('edit')"><i class="fas fa-save me-2"></i> Update Customer</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 1. Save Function (Add & Edit)
        function saveCustomer(mode) {
            var formId = mode === 'add' ? 'addCustomerForm' : 'editCustomerForm';
            var url = mode === 'add' ? '/Customer/Create' : '/Customer/Edit';
            var form = document.getElementById(formId);
            var formData = new FormData(form);

            fetch(url, {
                method: "POST",
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(error => alert("An error occurred. Please try again."));
        }

        // 2. Open Edit Modal
        function openEditModal(id) {
            fetch(`/Customer/Edit?id=${id}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('edit_Id').value = data.data.id;
                    document.getElementById('edit_CustomerName').value = data.data.customerName;
                    document.getElementById('edit_CustomerType').value = data.data.customerType;
                    new bootstrap.Modal(document.getElementById('editCustomerModal')).show();
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(error => alert("Failed to load customer data."));
        }

        // 3. Delete Customer
        function deleteCustomer(id) {
            if (confirm("Are you sure you want to delete this customer?")) {
                var formData = new FormData();
                formData.append('id', id);
                fetch("/Customer/Delete", {
                    method: "POST",
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert("Error: " + data.message);
                    }
                })
                .catch(error => alert("An error occurred while deleting."));
            }
        }

        
        function searchCustomers() {
            var searchTerm = document.getElementById('searchInput').value.trim();
            
            window.location.href = `/Customer/Index?page=1&searchTerm=${encodeURIComponent(searchTerm)}`;
        }
    </script>
</body>
</html>