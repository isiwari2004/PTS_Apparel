@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>ApparelPTS Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            body {
                background-color: #f0f4f8;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .login-card {
                display: flex;
                width: 1000px;
                max-width: 95%;
                background: white;
                border-radius: 20px;
                box-shadow: 0 15px 35px rgba(0,0,0,0.1);
                overflow: hidden;
                min-height: 600px;
            }

            /* Left Side Design */
            .left-side {
                background-color: #203455;
                width: 45%;
                padding: 40px;
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
            }

                .left-side::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: radial-gradient(circle at 10% 20%, rgba(255,255,255,0.05) 0%, transparent 50%);
                    pointer-events: none;
                }

            .logo-area {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 30px;
            }

            .logo-box {
                width: 45px;
                height: 45px;
                background: #27ae60;
                border-radius: 12px;
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 22px;
                color: white;
            }

            .app-name {
                font-size: 20px;
                font-weight: 700;
            }

            .app-sub {
                font-size: 12px;
                opacity: 0.7;
                display: block;
                margin-top: -2px;
            }

            .feature-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
                margin-top: 20px;
            }

            .feature-box {
                background: rgba(255,255,255,0.08);
                padding: 20px;
                border-radius: 15px;
                text-align: center;
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255,255,255,0.05);
                transition: 0.3s;
            }

                .feature-box:hover {
                    background: rgba(255,255,255,0.15);
                    transform: translateY(-5px);
                }

            .feature-icon {
                color: #27ae60;
                font-size: 28px;
                margin-bottom: 8px;
                display: block;
            }

            .feature-title {
                font-size: 14px;
                font-weight: 500;
            }

            .flow-section {
                margin-top: 30px;
            }

            .flow-title {
                font-size: 10px;
                letter-spacing: 2px;
                text-align: center;
                opacity: 0.6;
                margin-bottom: 10px;
                text-transform: uppercase;
            }

            .flow-lines {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 10px;
            }

            .flow-line {
                flex: 1;
                height: 4px;
                margin: 0 3px;
                border-radius: 2px;
                background: rgba(255,255,255,0.15);
            }

                .flow-line.active {
                    background: #27ae60;
                }

            .flow-labels {
                display: flex;
                justify-content: space-between;
                margin-top: 5px;
                font-size: 9px;
                opacity: 0.5;
                text-transform: uppercase;
                padding: 0 5px;
            }

            .footer-text {
                margin-top: 30px;
            }

                .footer-text h4 {
                    font-size: 16px;
                    font-weight: 600;
                    margin-bottom: 5px;
                }

                .footer-text p {
                    font-size: 12px;
                    opacity: 0.7;
                    line-height: 1.4;
                }

            /* Right Side Design */
            .right-side {
                width: 55%;
                padding: 50px 60px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

                .right-side h2 {
                    font-weight: 700;
                    color: #222;
                    margin-bottom: 8px;
                }

                .right-side p.subtitle {
                    color: #777;
                    font-size: 14px;
                    margin-bottom: 30px;
                }

            .form-label {
                font-weight: 600;
                font-size: 13px;
                color: #444;
                margin-bottom: 5px;
            }

            .input-group {
                margin-bottom: 20px;
            }

            .input-group-text {
                background: white;
                border-right: none;
                color: #999;
            }

            .form-control {
                border-left: none;
                box-shadow: none;
                padding: 10px 12px;
                background: #fafbfc;
            }

                .form-control:focus {
                    background: white;
                    border-color: #203455;
                    box-shadow: 0 0 0 0.25rem rgba(32, 52, 85, 0.1);
                }

            .input-group:focus-within .input-group-text {
                border-color: #203455;
            }

            .input-group:focus-within .form-control {
                border-color: #203455;
            }

            .role-display {
                background: #f8f9fa;
                border: 1px solid #dee2e6;
                border-radius: 0.375rem;
                padding: 10px 15px;
                font-size: 14px;
                color: #333;
                margin-bottom: 20px;
            }

                .role-display strong {
                    color: #203455;
                }

            .btn-custom {
                background-color: #203455;
                color: white;
                width: 100%;
                border: none;
                padding: 12px;
                border-radius: 8px;
                font-weight: 600;
                font-size: 16px;
                transition: 0.3s;
            }

                .btn-custom:hover {
                    background-color: #15263f;
                    color: white;
                }

            .form-check-label {
                font-size: 14px;
                color: #666;
            }

            .forgot-pass {
                font-size: 14px;
                text-decoration: none;
                color: #203455;
                font-weight: 500;
            }

            .eye-icon {
                cursor: pointer;
                color: #aaa;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Left Side -->
        <div class="left-side">
            <div>
                <div class="logo-area">
                    <div class="logo-box"><i class="fas fa-cut"></i></div>
                    <div>
                        <div class="app-name">ApparelPTS</div>
                        <span class="app-sub">Production Tracking System</span>
                    </div>
                </div>

                <div class="feature-grid">
                    <div class="feature-box"><i class="fas fa-cut feature-icon"></i><div class="feature-title">Cutting</div></div>
                    <div class="feature-box"><i class="fas fa-layer-group feature-icon"></i><div class="feature-title">Assembly</div></div>
                    <div class="feature-box"><i class="fas fa-box feature-icon"></i><div class="feature-title">Packing</div></div>
                    <div class="feature-box"><i class="fas fa-chart-line feature-icon"></i><div class="feature-title">Tracking</div></div>
                </div>

                <div class="flow-section">
                    <div class="flow-title">Production Flow</div>
                    <div class="flow-lines">
                        <div class="flow-line active"></div>
                        <div class="flow-line active"></div>
                        <div class="flow-line active"></div>
                        <div class="flow-line active"></div>
                        <div class="flow-line"></div>
                        <div class="flow-line"></div>
                    </div>
                    <div class="flow-labels">
                        <span>Design</span><span>Cut</span><span>Sew</span><span>QC</span><span>Pack</span><span>Ship</span>
                    </div>
                </div>
            </div>

            <div class="footer-text">
                <h4>Manage apparel production efficiently and securely.</h4>
                <p>Real-time visibility across your factory floor.</p>
            </div>
        </div>

        <!-- Right Side -->
        <div class="right-side">
            <h2>Welcome Back</h2>
            <p class="subtitle">Please sign in to continue to the Production Tracking System.</p>

            <form asp-action="Login" method="post" id="loginForm">

                
                <div class="mb-2">
                    <label class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" id="usernameInput" name="username" class="form-control" placeholder="Enter your username" required>
                    </div>
                </div>

              
                <div class="mb-2">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" id="passwordInput" name="password" class="form-control" placeholder="Enter your password" required>
                        <span class="input-group-text eye-icon" onclick="togglePassword()"><i class="fas fa-eye"></i></span>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Role</label>
                    <div class="role-display" id="roleDisplay">
                        <i class="fas fa-user-shield me-2" style="color:#203455;"></i> <span id="roleText">Enter username to see role</span>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2">@ViewBag.Error</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                    <a href="#" class="forgot-pass">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-custom">Login</button>
            </form>
        </div>
    </div>

    <script>
            
            function togglePassword() {
                var passwordInput = document.getElementById("passwordInput");
                var icon = document.querySelector(".eye-icon i");
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    passwordInput.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            }

            
            document.addEventListener("DOMContentLoaded", function() {
                var usernameInput = document.getElementById("usernameInput");
                var roleText = document.getElementById("roleText");

                function checkRole() {
                    var username = usernameInput.value.trim();

                    if (username.length > 0) {
                        fetch(`/Account/GetUserRole?username=${encodeURIComponent(username)}`)
                            .then(response => response.json())
                            .then(data => {
                                if (data.role) {
                                    
                                    roleText.innerHTML = `<strong>${data.role}</strong>`;
                                } else {
                                    roleText.innerText = "User not found";
                                }
                            })
                            .catch(error => {
                                roleText.innerText = "Enter username";
                            });
                    } else {
                        roleText.innerText = "Enter username to see role";
                    }
                }

                usernameInput.addEventListener("keyup", checkRole);
            });
    </script>

</body>
</html>