@model PTS_Apparel.Models.AddPOViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Add PO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Global */
        body { 
            background: #f4f6f9; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            padding: 20px; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Modal Card - Image එකට හරියන Design */
        .modal-card { 
            background: white; 
            border-radius: 16px; 
            max-width: 900px; 
            width: 100%; 
            padding: 30px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.08); 
            position: relative;
            max-height: 95vh;
            display: flex;
            flex-direction: column;
        }

        /* Scrollable Area inside Modal */
        .modal-scroll-area { 
            overflow-y: auto; 
            padding-right: 10px; 
            flex: 1; 
        }
        .modal-scroll-area::-webkit-scrollbar { width: 6px; }
        .modal-scroll-area::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }

        /* Header Icon */
        .header-icon { 
            width: 48px; height: 48px; 
            background: #eef2ff; 
            color: #2563a0; 
            border-radius: 12px; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            font-size: 20px; 
            margin-right: 15px; 
        }

        /* Form Labels & Inputs */
        .form-label { font-weight: 600; color: #1e3250; font-size: 14px; margin-bottom: 5px; }
        .form-control, .form-select { 
            border-radius: 8px; 
            background: #fafbfc; 
            border: 1px solid #e0e0e0; 
            padding: 10px 15px; 
            color: #333;
        }
        .form-control:focus, .form-select:focus { 
            border-color: #203455; 
            box-shadow: 0 0 0 0.2rem rgba(32, 52, 85, 0.1); 
            background: white;
        }

        /* Size Breakdown Table */
        .size-table-container { 
            background: white; 
            border: 1px solid #eef2f6; 
            border-radius: 10px; 
            overflow: hidden; 
            margin-top: 10px; 
        }
        .size-table { width: 100%; border-collapse: collapse; font-size: 14px; }
        .size-table th { 
            background: #f8fafc; 
            padding: 12px 15px; 
            color: #6c757d; 
            font-weight: 600; 
            border-bottom: 1px solid #eef2f6; 
            text-align: left; 
            font-size: 12px;
            text-transform: uppercase;
        }
        .size-table td { padding: 12px 15px; border-bottom: 1px solid #f1f4f8; vertical-align: middle; }

        /* Size Inputs */
        .size-input { 
            width: 100%; 
            max-width: 90px; 
            text-align: center; 
            border: 1px solid #e0e0e0; 
            border-radius: 6px; 
            padding: 5px 8px; 
            background: white; 
        }
        .size-input:focus { border-color: #203455; outline: none; }

        .empty-state-row td { padding: 40px 0; color: #999; }
        .empty-state-row .icon-bg { 
            width: 60px; height: 60px; 
            background: #f8fafc; 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin: 0 auto 10px auto; 
            color: #d1d5db; 
            font-size: 24px; 
        }

        /* Total Order Quantity Box */
        .total-box { 
            background: #f8fafc; 
            border: 1px solid #eef2f6; 
            border-radius: 10px; 
            padding: 15px 20px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-top: 15px; 
        }

        /* Bottom Buttons */
        .btn-green { 
            background: #2ecc71; 
            color: white; 
            border: none; 
            border-radius: 8px; 
            padding: 8px 25px; 
            font-weight: 600; 
            transition: 0.2s; 
        }
        .btn-green:hover { background: #27ae60; color: white; }
        
        .btn-dark-save { 
            background: #203455; 
            color: white; 
            border: none; 
            border-radius: 8px; 
            padding: 8px 25px; 
            font-weight: 600; 
            transition: 0.2s; 
        }
        .btn-dark-save:hover { background: #14263f; color: white; }

        .footer-actions { 
            border-top: 1px solid #eef2f6; 
            padding-top: 20px; 
            margin-top: 20px; 
            display: flex; 
            justify-content: flex-end; 
            gap: 15px; 
            background: white; 
        }

        .input-group-text { background: white; border-left: none; color: #6c757d; }
    </style>
</head>
<body>
    <div class="modal-card">
        <!-- Header -->
        <div class="d-flex align-items-center mb-4">
            <div class="header-icon"><i class="fas fa-file-invoice"></i></div>
            <div>
                <h4 style="font-weight: 700; color: #1e3250; margin:0;">Add PO</h4>
                <p class="text-muted" style="margin:0; font-size: 13px;">Create a new PO with style, colour, and size quantity breakdown.</p>
            </div>
        </div>

        <div class="modal-scroll-area">
            <form id="addPOForm">
                <!-- PO Number -->
                <div class="mb-3">
                    <label class="form-label">PO Number</label>
                    <input type="text" class="form-control" name="PONumber" placeholder="e.g. PO 137009" required>
                </div>

                <!-- Style -->
                <div class="mb-3">
                    <label class="form-label">Style</label>
                    <select class="form-select" id="ddlStyle" name="StyleCode" required onchange="loadColors()">
                        <option value="">Select style</option>
                        @if (ViewBag.Styles != null)
                        {
                            foreach (var style in ViewBag.Styles as List<string>)
                            {
                                <option value="@style">@style</option>
                            }
                        }
                    </select>
                </div>

                <!-- Colour & Tolerance Row -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Colour</label>
                        <select class="form-select" id="ddlColor" name="ColorCode" required onchange="loadSizeTable()">
                            <option value="">Select colour</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tolerance</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="toleranceInput" name="Tolerance" value="5" min="0" max="100" step="1" oninput="calculateTotals()">
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="text-muted" style="font-size: 11px; margin-top: 3px;">Allowed quantity tolerance percentage.</div>
                    </div>
                </div>

                <!-- Size Breakdown Table -->
                <div>
                    <label class="form-label mb-2">Size Breakdown</label>
                    <div class="size-table-container">
                        <table class="size-table" id="sizeTable">
                            <thead>
                                <tr>
                                    <th>SIZE</th>
                                    <th>TOLERANCE QTY</th>
                                    <th>FINAL QUANTITY</th>
                                </tr>
                            </thead>
                            <tbody id="sizeTableBody">
                                <tr class="empty-state-row">
                                    <td colspan="3">
                                        <div class="icon-bg"><i class="fas fa-cube"></i></div>
                                        <h6 style="color:#333;">No sizes loaded</h6>
                                        <p style="font-size: 13px;">Select a style and colour to populate size rows.</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Total Order Quantity Box -->
                <div class="total-box">
                    <div>
                        <i class="fas fa-cube me-2 text-muted"></i> 
                        <span style="font-weight: 500; color: #333;">Total Order Quantity</span>
                    </div>
                    <div>
                        <span style="color: #6c757d; font-size: 14px;">Final:</span> 
                        <strong id="totalFinalQty" style="color:#1e3250; font-size: 18px; margin: 0 5px;">0</strong> 
                        <span style="color: #6c757d; font-size: 14px;">pcs</span>
                    </div>
                </div>
            </form>
        </div>

        <!-- Footer Buttons -->
        <div class="footer-actions">
            <button type="button" class="btn-green"><i class="fas fa-upload me-2"></i> Upload</button>
            <button type="button" class="btn btn-outline-secondary" style="border-radius: 8px; padding: 8px 25px;" onclick="window.history.back()">Cancel</button>
            <button type="button" class="btn-dark-save" onclick="submitPO()"><i class="fas fa-save me-2"></i> Save PO</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 1. Load Colors based on selected Style
        function loadColors() {
            var styleCode = document.getElementById('ddlStyle').value;
            var colorDdl = document.getElementById('ddlColor');
            
            // Reset color dropdown and table
            colorDdl.innerHTML = '<option value="">Select colour</option>';
            document.getElementById('sizeTableBody').innerHTML = `
                <tr class="empty-state-row">
                    <td colspan="3">
                        <div class="icon-bg"><i class="fas fa-cube"></i></div>
                        <h6 style="color:#333;">No sizes loaded</h6>
                        <p style="font-size: 13px;">Select a style and colour to populate size rows.</p>
                    </td>
                </tr>
            `;
            document.getElementById('totalFinalQty').innerText = '0';

            if (!styleCode) return;

            fetch(`/POManagement/GetColorsByStyle?styleCode=${encodeURIComponent(styleCode)}`)
            .then(r => r.json())
            .then(data => {
                data.forEach(color => {
                    var opt = document.createElement('option');
                    opt.value = color;
                    opt.innerText = color;
                    colorDdl.appendChild(opt);
                });
            });
        }

        // 2. Load Size Table based on selected Style and Color
        function loadSizeTable() {
            var styleCode = document.getElementById('ddlStyle').value;
            var colorCode = document.getElementById('ddlColor').value;
            var tbody = document.getElementById('sizeTableBody');

            if (!styleCode || !colorCode) {
                tbody.innerHTML = `<tr class="empty-state-row"><td colspan="3"><div class="icon-bg"><i class="fas fa-cube"></i></div><h6 style="color:#333;">No sizes loaded</h6><p style="font-size: 13px;">Select a style and colour to populate size rows.</p></td></tr>`;
                document.getElementById('totalFinalQty').innerText = '0';
                return;
            }

            fetch(`/POManagement/GetSizesByStyleAndColor?styleCode=${encodeURIComponent(styleCode)}&colorCode=${encodeURIComponent(colorCode)}`)
            .then(r => r.json())
            .then(data => {
                if (data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="3" class="text-muted text-center py-3">No sizes found for this combination.</td></tr>`;
                    return;
                }

                tbody.innerHTML = '';
                data.forEach(item => {
                    var row = `
                        <tr>
                            <td><strong>${item.sizeName}</strong></td>
                            <td>
                                <input type="number" class="size-input tolerance-qty" value="${item.toleranceQty}" 
                                       oninput="calculateRowFinal(this)" />
                            </td>
                            <td>
                                <input type="number" class="size-input final-qty" value="${item.finalQuantity}" readonly />
                            </td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                });
                calculateTotals();
            });
        }

        // 3. Calculate Final Quantity for a specific row
        function calculateRowFinal(inputElement) {
            var tolerance = parseFloat(document.getElementById('toleranceInput').value) || 0;
            var orderQty = parseInt(inputElement.value) || 0;
            
            var row = inputElement.closest('tr');
            var finalInput = row.querySelector('.final-qty');
            
            // Logic: Final = ToleranceQty + (ToleranceQty * Tolerance%)
            var finalQty = Math.round(orderQty + (orderQty * (tolerance / 100)));
            
            finalInput.value = finalQty;
            calculateTotals();
        }

        // 4. Calculate Grand Total
        function calculateTotals() {
            var finalInputs = document.querySelectorAll('.final-qty');
            var total = 0;
            finalInputs.forEach(inp => {
                total += parseInt(inp.value) || 0;
            });
            document.getElementById('totalFinalQty').innerText = total;
        }

        // 5. Submit PO to Backend
        function submitPO() {
            var form = document.getElementById('addPOForm');
            var formData = new FormData(form);

            // Collect size details
            var sizeDetails = [];
            document.querySelectorAll('#sizeTableBody tr').forEach(row => {
                // Skip empty state rows
                if (row.querySelector('td[colspan]')) return; 

                var sizeName = row.querySelector('td:first-child').innerText.trim();
                var toleranceQty = parseInt(row.querySelector('.tolerance-qty').value) || 0;
                var finalQuantity = parseInt(row.querySelector('.final-qty').value) || 0;

                sizeDetails.push({
                    SizeName: sizeName,
                    OrderQty: toleranceQty,
                    ToleranceQty: toleranceQty,
                    FinalQuantity: finalQuantity
                });
            });

            if (sizeDetails.length === 0) {
                alert("Please select a style and colour to load sizes.");
                return;
            }

            // Build final object for Backend
            var finalObject = {
                PONumber: document.querySelector('[name="PONumber"]').value,
                StyleCode: document.querySelector('[name="StyleCode"]').value,
                ColorCode: document.querySelector('[name="ColorCode"]').value,
                Tolerance: parseFloat(document.querySelector('[name="Tolerance"]').value) || 0,
                SizeDetails: sizeDetails
            };

            fetch("/POManagement/SavePO", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(finalObject)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.href = '/POManagement/Index';
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(error => console.error("Error saving PO:", error));
        }
    </script>
</body>
</html>