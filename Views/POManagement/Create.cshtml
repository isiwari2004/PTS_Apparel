@model PTS_Apparel.Models.PO
@{
    Layout = null;
    var isEdit = Model.Id > 0;
    var pageTitle = isEdit ? "Edit PO" : "Add PO";
    var buttonText = isEdit ? "Update" : "Save";
}
<!DOCTYPE html>
<html>
<head>
    <title>@pageTitle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            body {
                background: #f4f6f9;
                margin: 0;
                padding: 20px;
                font-family: 'Segoe UI';
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .back-btn {
                color: #203455;
                text-decoration: none;
                margin-bottom: 15px;
                display: inline-block;
                font-weight: 500;
            }

            .main-card {
                background: white;
                border-radius: 16px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.08);
                max-width: 600px;
                width: 100%;
                padding: 30px;
                position: relative;
            }

            .form-label {
                font-weight: 600;
                font-size: 14px;
                color: #333;
            }

            .form-control, .form-select {
                border-radius: 8px;
                background: #fafbfc;
                border: 1px solid #e0e0e0;
                padding: 8px 12px;
                font-size: 14px;
            }

                .form-control:focus, .form-select:focus {
                    border-color: #203455;
                    box-shadow: 0 0 0 0.2rem rgba(32, 52, 85, 0.1);
                }

            .btn-custom-save {
                background: #203455;
                color: white;
                border-radius: 8px;
                padding: 10px 25px;
                border: none;
                font-weight: 600;
                width: 100%;
            }

                .btn-custom-save:hover {
                    background: #14263f;
                    color: white;
                }

            .btn-cancel {
                width: 100%;
            }

            @@media (max-width: 768px) {
                body {
                    align-items: flex-start;
                    padding: 10px;
                    height: auto;
                }
            }
    </style>
</head>
<body>
    <div style="max-width: 600px; width: 100%;">
        <a href="/POManagement/Index" class="back-btn"><i class="fas fa-arrow-left me-2"></i> Back to PO Management</a>

        <div class="main-card">
            <h5 style="font-weight: 700; color: #1e3250; margin-bottom: 20px;">@pageTitle</h5>
            <form id="poForm" action="/POManagement/Upsert" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">PO Number</label>
                    <input type="text" class="form-control" name="PONumber" value="@Model.PONumber" placeholder="e.g. 1020604" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Customer</label>
                    <input type="text" class="form-control" name="Customer" value="@Model.Customer" placeholder="e.g. SUPERDRY" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Style</label>
                    <input type="text" class="form-control" name="Style" value="@Model.Style" placeholder="e.g. M5011132A" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Color</label>
                    <input type="text" class="form-control" name="Color" value="@Model.Color" placeholder="e.g. DARK KHAKI" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" class="form-control" name="Quantity" value="@Model.Quantity" placeholder="800" required>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-outline-secondary btn-cancel" onclick="window.location.href='/POManagement/Index'">Cancel</button>
                    <button type="button" class="btn-custom-save" onclick="savePO()">@buttonText</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            function savePO() {
                var form = document.getElementById('poForm');
                var formData = new FormData(form);
                fetch("/POManagement/Upsert", {
                    method: "POST",
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        window.location.href = '/POManagement/Index';
                    } else {
                        alert("Error: " + data.message);
                    }
                });
            }
    </script>
</body>
</html>