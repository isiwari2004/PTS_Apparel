@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Register New User - ApparelPTS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            body {
                background-color: #f0f4f8;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                margin: 0;
                font-family: 'Segoe UI';
            }

            .register-card {
                width: 500px;
                max-width: 95%;
                background: white;
                border-radius: 20px;
                padding: 40px;
                box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            }

                .register-card h2 {
                    font-weight: 700;
                    color: #222;
                    margin-bottom: 8px;
                }

            .form-label {
                font-weight: 600;
                font-size: 13px;
                color: #444;
            }

            .input-group-text {
                background: white;
                border-right: none;
                color: #999;
            }

            .form-control {
                border-left: none;
                box-shadow: none;
                padding: 10px 12px;
                background: #fafbfc;
            }

                .form-control:focus {
                    border-color: #203455;
                    box-shadow: 0 0 0 0.25rem rgba(32, 52, 85, 0.1);
                }

            .btn-custom {
                background-color: #203455;
                color: white;
                width: 100%;
                border: none;
                padding: 12px;
                border-radius: 8px;
                font-weight: 600;
            }

                .btn-custom:hover {
                    background-color: #15263f;
                    color: white;
                }

            .back-link {
                text-decoration: none;
                color: #203455;
                font-weight: 500;
                margin-bottom: 20px;
                display: block;
            }
    </style>
</head>
<body>
    <div class="register-card">
        <a href="/Home/Dashboard" class="back-link"><i class="fas fa-arrow-left me-2"></i> Back to Dashboard</a>
        <h2>Register New User</h2>
        <p class="text-muted mb-4">Create a new user account for the Production Tracking System.</p>

        <form asp-action="Register" method="post">

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input type="text" name="fullName" class="form-control" placeholder="Enter full name" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="Enter username" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Enter password" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Role</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                    <select name="role" class="form-control" style="border-left: none; background: #fafbfc;" required>
                        <option value="User">User</option>
                        <option value="Super User">Super User</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success py-2">@ViewBag.Success</div>
            }

            <button type="submit" class="btn btn-custom mt-2"><i class="fas fa-save me-2"></i> Register User</button>
        </form>
    </div>
</body>
</html>