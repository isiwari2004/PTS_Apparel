@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Dashboard - ApparelPTS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            
            body, html {
                margin: 0;
                padding: 0;
                height: 100%;
                width: 100%;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                overflow: hidden;
            }

            body {
                display: flex;
                background: #f4f6f9;
            }

            /* ==========================================
                       2. Sidebar 
                       ========================================== */
            .sidebar {
                width: 250px;
                background-color: #1e3250;
                color: white;
                height: 100vh;
                padding: 20px;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1000;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .sidebar-menu {
                flex: 1;
                overflow-y: auto;
                padding-right: 5px;
            }

                .sidebar-menu::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-menu::-webkit-scrollbar-thumb {
                    background-color: rgba(255,255,255,0.2);
                    border-radius: 10px;
                }

            .sidebar a {
                color: #a4b6d4;
                text-decoration: none;
                display: block;
                padding: 10px;
                border-radius: 5px;
                margin-bottom: 5px;
                transition: 0.2s;
                font-size: 14px;
            }

                .sidebar a:hover, .sidebar a.active {
                    background: rgba(255,255,255,0.1);
                    color: white;
                }

            .green-icon {
                color: #2ecc71;
                font-size: 1.2rem;
            }

            .sidebar hr {
                border-color: rgba(255,255,255,0.1);
                margin: 10px 0;
            }

            .sidebar-bottom {
                padding-top: 10px;
                border-top: 1px solid rgba(255,255,255,0.1);
                margin-top: auto;
                text-align: center;
            }

                .sidebar-bottom a {
                    font-size: 14px;
                    margin: 0;
                    background: rgba(220, 53, 69, 0.15);
                    color: #ff6b6b !important;
                }

                    .sidebar-bottom a:hover {
                        background: rgba(220, 53, 69, 0.3) !important;
                    }

            /* ==========================================
                       3. Content Container (Background Image Full Screen)
                       ========================================== */
            .content {
                flex: 1;
                margin-left: 250px;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                width: calc(100% - 250px);
                background: #eaf4ff;
                box-sizing: border-box;
                padding: 0; 
                position: relative;
            }

           
            .dashboard-image-container {
                width: 100%;
                height: 100%;
                
                background-image: url('/images/dashboard_bg.png');
               
                background-size: cover;
                background-position: center; 
                background-repeat: no-repeat;
                display: flex;
                flex-direction: column;
                justify-content: flex-end; 
                align-items: center;
                padding-bottom: 50px; 
            }

            /* Welcome Text එක */
            .welcome-overlay {
                background: rgba(255, 255, 255, 0.9);
                padding: 15px 30px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
                border: 1px solid #eef2f6;
                text-align: center;
                font-weight: 600;
                color: #1e3250;
                max-width: 400px;
            }

            /* Responsive */
            @@media (max-width: 768px) {
                .sidebar {
                    display: none;
                }

                .content {
                    margin-left: 0;
                    width: 100%;
                    padding: 0;
                }
            }
    </style>
</head>
<body>
    <!-- =============== SIDEBAR =============== -->
    <div class="sidebar">
        <h5><i class="fas fa-cut green-icon"></i> ApparelPTS</h5>
        <hr>

        <div class="sidebar-menu">
            <a href="/Home/Dashboard" class="active"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="/Factory/Index"><i class="fas fa-industry"></i> Factory</a>
            <a href="/Customer/Index"><i class="fas fa-user-friends"></i> Customer</a>
            <a href="/Style/Index"><i class="fas fa-tshirt"></i> Style</a>
            <a href="/POManagement/Index"><i class="fas fa-file-invoice"></i> PO</a>
            <a href="/InputRecorder/Index"><i class="fas fa-clipboard-list"></i> Input Recorder</a>
            <a href="/Forecast/Index"><i class="fas fa-chart-line"></i> Forecast</a>
            <a href="#"><i class="fas fa-list-ul"></i> Line Recorder</a>
            <a href="#"><i class="fas fa-clock"></i> Hourly Tracking</a>
            <a href="#"><i class="fas fa-exclamation-triangle"></i> Defect Report</a>

            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a href="/Home/ScreenPrivileges"><i class="fas fa-lock"></i> Screen Privileges</a>
                <a href="/User/Register"><i class="fas fa-user-plus"></i> User Register</a>
            }
        </div>

        <div class="sidebar-bottom">
            <a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <!-- =============== CONTENT (IMAGE ONLY) =============== -->
    <div class="content">
        <div class="dashboard-image-container">

      

        </div>
    </div>
</body>
</html>