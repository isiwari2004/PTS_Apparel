@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Add Style</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { background: #f4f6f9; margin: 0; padding: 20px; font-family: 'Segoe UI'; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .back-btn { color: #203455; text-decoration: none; margin-bottom: 15px; display: inline-block; font-weight: 500; }
        .main-card { background: white; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; flex-wrap: wrap; overflow: hidden; max-width: 1100px; width: 100%; height: 80vh; max-height: 750px; position: relative; }
        .form-section { padding: 30px 40px 80px 40px; width: 50%; border-right: 1px solid #eef2f6; overflow-y: auto; height: 100%; box-sizing: border-box; }
        .form-section h5 { font-weight: 700; color: #1e3250; margin-bottom: 20px; }
        .form-label { font-weight: 600; font-size: 14px; color: #333; margin-bottom: 5px; }
        .form-control, .form-select { border-radius: 8px; background: #fafbfc; border: 1px solid #e0e0e0; padding: 10px 15px; }
        .form-control:focus, .form-select:focus { border-color: #203455; box-shadow: 0 0 0 0.2rem rgba(32, 52, 85, 0.1); }
        .size-input-group { display: flex; gap: 10px; }
        .size-input-group input { flex: 1; }
        .drop-zone { border: 2px dashed #d1d5db; border-radius: 12px; padding: 25px; text-align: center; background: #f8fafc; margin: 15px 0 25px 0; transition: 0.3s; cursor: pointer; position: relative; }
        .drop-zone:hover { border-color: #203455; background: #f1f5f9; }
        .drop-zone i { font-size: 35px; color: #2563a0; background: #e3edfb; padding: 15px; border-radius: 50%; margin-bottom: 10px; }
        .drop-zone p { margin: 0; font-weight: 500; color: #333; }
        .drop-zone small { color: #2563a0; text-decoration: underline; cursor: pointer; }
        .drop-zone .ext-badges span { background: #e5e7eb; color: #555; padding: 2px 8px; border-radius: 4px; font-size: 11px; margin: 0 3px; }
        .drop-zone input[type="file"] { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
        .preview-section { padding: 30px 40px; width: 50%; background: #fbfbfd; display: flex; flex-direction: column; height: 100%; box-sizing: border-box; }
        .preview-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .preview-header h5 { font-weight: 700; color: #1e3250; margin: 0; }
        .preview-table-container { background: white; border: 1px solid #eef2f6; border-radius: 10px; flex: 1; overflow: hidden; display: flex; flex-direction: column; }
        .preview-table { width: 100%; border-collapse: collapse; }
        .preview-table th { background: #f8fafc; padding: 12px 15px; font-weight: 600; font-size: 12px; color: #778ca2; text-align: left; border-bottom: 1px solid #eef2f6; }
        .preview-table td { padding: 12px 15px; border-bottom: 1px solid #f1f4f8; }
        .empty-state { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #999; }
        .empty-state i { font-size: 50px; color: #d1d5db; margin-bottom: 15px; }
        .empty-state h6 { color: #333; font-weight: 600; margin-top: 10px; }
        .empty-state p { font-size: 13px; color: #999; }
        .footer-actions { position: absolute; bottom: 0; left: 0; width: 100%; background: white; padding: 15px 30px; border-top: 1px solid #eef2f6; display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; z-index: 10; }
        .footer-left { display: flex; gap: 10px; }
        .footer-right { display: flex; gap: 15px; }
        .btn-green-upload { background: #2ecc71; color: white; border: none; border-radius: 8px; padding: 10px 25px; font-weight: 600; transition: 0.2s; display: flex; align-items: center; gap: 8px;}
        .btn-green-upload:hover { background: #27ae60; color: white; }
        .btn-custom-save { background: #203455; color: white; border: none; border-radius: 8px; padding: 10px 25px; font-weight: 600; transition: 0.2s; }
        .btn-custom-save:hover { background: #14263f; color: white; }
        .btn-outline-custom { border: 1px solid #ddd; background: white; padding: 10px 25px; border-radius: 8px; color: #555; transition: 0.2s; }
        .btn-outline-custom:hover { background: #f8f9fa; }
        @@media (max-width: 768px) { body { align-items: flex-start; padding: 10px; height: auto; } .main-card { flex-direction: column; height: auto; max-height: none; } .form-section { width: 100%; border-right: none; height: auto; padding: 20px 20px 80px 20px; } .preview-section { width: 100%; height: 400px; padding: 20px; } .footer-actions { flex-direction: column-reverse; padding: 15px; } }
    </style>
</head>
<body>
    <div style="max-width: 1100px; width: 100%;">
        <a href="/Style/Index" class="back-btn"><i class="fas fa-arrow-left me-2"></i> Back to Style Management</a>

        <div class="main-card">
            <!-- Left: Form -->
            <div class="form-section">
                <h5>Enter Style Details</h5>
                <form id="addStyleForm">
                    <div class="mb-3">
                        <label class="form-label">Customer</label>
                        <select class="form-select" id="CustomerName" name="CustomerName" required>
                            <option value="">Select customer</option>
                            @if (ViewBag.Customers != null)
                            {
                                foreach (var cust in ViewBag.Customers as List<PTS_Apparel.Models.Customer>)
                                {
                                    <option value="@cust.CustomerName">@cust.CustomerName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Style</label>
                        <input type="text" class="form-control" id="StyleCode" name="StyleCode" placeholder="Enter style name" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Colour</label>
                        <input type="text" class="form-control" id="ColorCode" name="ColorCode" placeholder="Enter colour" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sizes</label>
                        <div class="size-input-group">
                            <input type="text" class="form-control" id="sizeInput" placeholder="Type sizes or click search">
                            <button type="button" class="btn btn-dark" onclick="addSize()">Add</button>
                        </div>
                        <input type="hidden" id="finalSizes" name="Sizes" />
                    </div>

                    <div class="mt-2 text-muted" style="font-size: 13px;">Or upload sizes from file</div>

                    <div class="drop-zone">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <p>Drag & drop file here</p>
                        <small>or <span style="color: #2563a0;">click to browse</span></small>
                        <div class="ext-badges mt-2">
                            <span>.xlsx</span>
                            <span>.xls</span>
                            <span>.csv</span>
                        </div>
                        <input type="file" id="excelFileInput" accept=".xlsx,.xls" onchange="uploadExcelFile()" />
                    </div>
                </form>
            </div>

            <!-- Right: Preview -->
            <div class="preview-section">
                <div class="preview-header">
                    <h5>Sizes Preview</h5>
                    <div>
                        <input type="text" class="preview-search" style="border-radius: 6px; border:1px solid #e0e0e0; padding: 4px 10px; font-size: 13px;" placeholder="Search sizes...">
                        <button class="btn btn-outline-secondary btn-sm" onclick="clearSizes()"><i class="fas fa-times-circle me-1"></i> Clear</button>
                    </div>
                </div>
                
                <div class="preview-table-container">
                    <table class="preview-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">COLOUR</th>
                                <th>SIZES</th>
                            </tr>
                        </thead>
                        <tbody id="previewTbody">
                            <tr id="noDataRow">
                                <td colspan="2">
                                    <div class="empty-state" style="height: 250px;">
                                        <i class="fas fa-folder-open"></i>
                                        <h6>No sizes added yet</h6>
                                        <p>Add sizes using the form to see the preview here.</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer -->
            <div class="footer-actions">
                <div class="footer-left">
                    <button type="button" class="btn-green-upload" onclick="document.getElementById('excelFileInput').click()">
                        <i class="fas fa-upload"></i> Upload
                    </button>
                </div>
                <div class="footer-right">
                    <button type="button" class="btn-outline-custom" onclick="window.location.href='/Style/Index'">Cancel</button>
                    <button type="button" class="btn-custom-save" onclick="saveStyle()"><i class="fas fa-save me-1"></i> Save</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        var addedSizes = [];

        function addSize() {
            var input = document.getElementById('sizeInput');
            var val = input.value.trim();
            if (val === '') return;
            addedSizes.push(val);
            input.value = '';
            updatePreview();
        }

        function clearSizes() {
            addedSizes = [];
            document.getElementById('sizeInput').value = '';
            document.getElementById('excelFileInput').value = '';
            updatePreview();
        }

        function updatePreview() {
            var tbody = document.getElementById('previewTbody');
            var color = document.getElementById('ColorCode').value.trim() || '-';
            document.getElementById('finalSizes').value = addedSizes.join(',');

            if (addedSizes.length === 0) {
                tbody.innerHTML = `<tr id="noDataRow"><td colspan="2">
                    <div class="empty-state" style="height: 250px;">
                        <i class="fas fa-folder-open"></i>
                        <h6>No sizes added yet</h6>
                        <p>Add sizes using the form to see the preview here.</p>
                    </div>
                </td></tr>`;
                return;
            }
            
            var uniqueSizes = [...new Set(addedSizes)];
            var sizesHtml = uniqueSizes.map(s => `<span class="badge bg-light text-dark border me-1" style="padding: 4px 10px; border-radius: 4px;">${s}</span>`).join(' ');
            
            tbody.innerHTML = `<tr><td style="font-weight: 500;">${color}</td><td>${sizesHtml}</td></tr>`;
        }

        function uploadExcelFile() {
            var fileInput = document.getElementById('excelFileInput');
            var file = fileInput.files[0];
            if (!file) return;

            var formData = new FormData();
            formData.append('file', file);

            fetch("/Style/UploadExcel", {
                method: "POST",
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    if(data.buyer) {
                        var dropdown = document.getElementById('CustomerName');
                        var found = false;
                        for(var opt of dropdown.options) {
                            if(opt.value.toLowerCase() === data.buyer.toLowerCase()) {
                                dropdown.value = opt.value;
                                found = true;
                                break;
                            }
                        }
                        if(!found) alert("Customer '" + data.buyer + "' found in Excel but not in System Dropdown. Please select manually.");
                    }
                    
                    document.getElementById('StyleCode').value = data.style || '';
                    document.getElementById('ColorCode').value = data.color || '';

                    addedSizes = []; 
                    if(data.sizes && data.sizes.length > 0) {
                        data.sizes.forEach(s => {
                            if (s.trim() !== '') addedSizes.push(s.trim());
                        });
                    }
                    updatePreview();
                    
                    fileInput.value = '';
                } else {
                    alert("Upload failed: " + data.message);
                }
            })
            .catch(error => {
                console.error(error);
                alert("Error uploading file.");
            });
        }

        
        function saveStyle() {
        
            console.log("Sizes Array:", addedSizes);

            if (addedSizes.length === 0) {
                alert("Please add at least one size.");
                return;
            }

            var customerName = document.getElementById('CustomerName').value;
            var styleCode = document.getElementById('StyleCode').value.trim();
            var colorCode = document.getElementById('ColorCode').value.trim();

            if(!customerName || !styleCode || !colorCode) {
                alert("Please ensure Customer, Style, and Colour fields are filled.");
                return;
            }

            // 2. Payload එක හදමු. Sizes එක array එකක් විදියටම යවමු (Controller එක එය comma string එකක් විදියට ගනී)
            var payload = {
                CustomerName: customerName,
                StyleCode: styleCode,
                ColorCode: colorCode,
                Sizes: addedSizes.join(',')
            };

            console.log("Sending Payload:", payload);

            // 3. Server එකට POST කිරීම
            fetch("/Style/SaveStyle", {
                method: "POST",
                headers: { 
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify(payload)
            })
            .then(response => {
                // JSON එක convert කිරීමට පෙර network error එකක් තියෙනවද බලමු
                if (!response.ok) {
                    throw new Error("Network response was not ok: " + response.statusText);
                }
                return response.json();
            })
            .then(data => {
                console.log("Server Response:", data);
                if (data.success) {
                    alert(data.message);
                    window.location.href = '/Style/Index';
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(err => {
                console.error("Fetch Error:", err);
                alert("Network or Server error: " + err.message);
            });
        }
    </script>
</body>
</html>